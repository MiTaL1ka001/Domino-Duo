# Domino Duo - Environment Variables Configuration

# ---------------------------------------------
# Backend (Node.js / Express / Socket.IO) - Render
# ---------------------------------------------
# Port to listen on (automatically injected by Render as PORT)
PORT=3001

# Host to bind to (0.0.0.0 is required for containerized environments like Render)
HOST=0.0.0.0

# Allowed Frontend Origins for CORS (comma-separated, or * for all)
# Example: https://domino-duo.vercel.app,http://localhost:5173
CLIENT_ORIGIN=*

# ---------------------------------------------
# Frontend (React / Vite) - Vercel
# ---------------------------------------------
# Full HTTPS URL of the deployed backend server (Socket.IO endpoint)
# In local development: http://localhost:3001
# In production: https://<your-render-service-name>.onrender.com
VITE_SERVER_URL=http://localhost:3001
